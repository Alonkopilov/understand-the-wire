### Terraform ###
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# .tfvars hold tokens and per-environment values. Note .terraform.lock.hcl is
# NOT ignored — it pins provider versions and belongs in version control.
*.tfvars
*.tfvars.json

# Local override files, used for experiments that should not be committed.
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration, which can contain credentials.
.terraformrc
terraform.rc

### Dependency and cache directories, wherever they appear ###
node_modules/
venv/
.venv/
__pycache__/

### Secrets ###
.env
.env.*
!.env.example

### Editors ###
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.idea/
.history/
*.swp
*.swo

### OS ###
.DS_Store
Thumbs.db

### Logs ###
*.log
